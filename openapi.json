{
    "openapi": "3.1.0",
    "info": {
        "title": "DearFutureMe API",
        "version": "0.0.0"
    },
    "paths": {
        "/api/v1/anchors": {
            "post": {
                "summary": "Create an anchor from the Arrival Interview",
                "operationId": "createAnchor",
                "tags": [
                    "Anchors"
                ],
                "security": [
                    {
                        "sanctum": []
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/Anchor.CreateData"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "The sealed anchor",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Anchor.AnchorData"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Authentication token is missing or invalid",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiErrorData"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "The account has not verified its email address",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiErrorData"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation failed",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiErrorData"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/bridge": {
            "post": {
                "summary": "Exchange a bearer credential for a session bridge link",
                "operationId": "createSessionBridge",
                "tags": [
                    "Auth"
                ],
                "security": [
                    {
                        "sanctum": []
                    }
                ],
                "responses": {
                    "200": {
                        "description": "A signed, single-use URL that signs the browser in on the security settings page when followed",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Auth.BridgeUrlData"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Authentication token is missing or invalid",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiErrorData"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "The account has not verified its email address",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiErrorData"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/email/resend": {
            "post": {
                "summary": "Resend the email verification message",
                "operationId": "emailResend",
                "tags": [
                    "Auth"
                ],
                "security": [
                    {
                        "sanctum": []
                    }
                ],
                "responses": {
                    "204": {
                        "description": "The verification message was sent (or the address is already verified)"
                    },
                    "401": {
                        "description": "Authentication token is missing or invalid",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiErrorData"
                                }
                            }
                        }
                    },
                    "429": {
                        "description": "Too many resend attempts",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiErrorData"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/user": {
            "get": {
                "summary": "Retrieve the currently authenticated user",
                "operationId": "getCurrentUser",
                "tags": [
                    "User"
                ],
                "security": [
                    {
                        "sanctum": []
                    }
                ],
                "responses": {
                    "200": {
                        "description": "The authenticated user",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/CurrentUserData"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Authentication token is missing or invalid",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiErrorData"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/register": {
            "post": {
                "summary": "Register a new account and return an auth token",
                "operationId": "register",
                "tags": [
                    "Auth"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/Auth.RegisterUserData"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "The created account and its auth token",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Auth.AuthTokenData"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation failed",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiErrorData"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/two-factor-challenge": {
            "post": {
                "summary": "Complete the two-factor challenge with an authenticator or recovery code",
                "operationId": "twoFactorChallenge",
                "tags": [
                    "Auth"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/Auth.TwoFactorChallengeData"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "The second factor was accepted and the credential is issued — the ticket is consumed whether the code is right or wrong",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Auth.AuthTokenData"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation failed, the code is wrong, or the ticket is missing, expired or bound to another account",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiErrorData"
                                }
                            }
                        }
                    },
                    "429": {
                        "description": "Too many challenge attempts",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiErrorData"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/forgot-password": {
            "post": {
                "summary": "Request a password reset link by email",
                "operationId": "forgotPassword",
                "tags": [
                    "Auth"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/Auth.ForgotPasswordData"
                            }
                        }
                    }
                },
                "responses": {
                    "202": {
                        "description": "A reset link was sent if the address is registered — the response never reveals whether it was"
                    },
                    "422": {
                        "description": "Validation failed",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiErrorData"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/login": {
            "post": {
                "summary": "Sign in and return an auth token",
                "operationId": "login",
                "tags": [
                    "Auth"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/Auth.LoginData"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "The authenticated account and its auth token, or a two-factor challenge ticket when the account has a second factor — a successful sign-in either way",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "oneOf": [
                                        {
                                            "$ref": "#/components/schemas/Auth.AuthTokenData"
                                        },
                                        {
                                            "$ref": "#/components/schemas/Auth.ChallengeTicketData"
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation failed or credentials did not match",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiErrorData"
                                }
                            }
                        }
                    },
                    "429": {
                        "description": "Too many sign-in attempts",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiErrorData"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/logout": {
            "post": {
                "summary": "Sign out of the current device",
                "operationId": "logout",
                "tags": [
                    "Auth"
                ],
                "security": [
                    {
                        "sanctum": []
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Signed out"
                    },
                    "401": {
                        "description": "Authentication token is missing or invalid",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiErrorData"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "securitySchemes": {
            "sanctum": {
                "type": "http",
                "scheme": "bearer"
            }
        },
        "schemas": {
            "Anchor.AnchorData": {
                "title": "Anchor",
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "goal": {
                        "type": "string"
                    },
                    "body": {
                        "type": "string"
                    },
                    "target_date": {
                        "type": "string"
                    },
                    "state": {
                        "type": "string",
                        "enum": [
                            "active",
                            "arrived",
                            "archived"
                        ]
                    },
                    "written_at": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time"
                    }
                },
                "required": [
                    "id",
                    "goal",
                    "body",
                    "target_date",
                    "state",
                    "written_at",
                    "created_at"
                ],
                "additionalProperties": false
            },
            "Anchor.CreateData": {
                "title": "Create",
                "type": "object",
                "properties": {
                    "goal": {
                        "type": "string",
                        "maxLength": 255
                    },
                    "body": {
                        "type": "string"
                    },
                    "target_date": {
                        "type": "string",
                        "x-date-format": "The value must match the format \"Y-m-d\".",
                        "x-date-after": "The value must be after 2026-09-03T00:00:00Z."
                    }
                },
                "required": [
                    "goal",
                    "body",
                    "target_date"
                ],
                "additionalProperties": false
            },
            "ApiErrorData": {
                "title": "Api Error",
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string"
                    },
                    "code": {
                        "type": "string",
                        "enum": [
                            "UNAUTHENTICATED",
                            "VALIDATION_ERROR",
                            "FORBIDDEN",
                            "NOT_FOUND",
                            "RATE_LIMITED",
                            "SERVER_ERROR"
                        ]
                    },
                    "errors": {
                        "default": null,
                        "type": [
                            "object",
                            "null"
                        ],
                        "additionalProperties": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                },
                "required": [
                    "message",
                    "code"
                ],
                "additionalProperties": false
            },
            "Auth.AuthTokenData": {
                "title": "Auth Token",
                "type": "object",
                "properties": {
                    "token": {
                        "type": "string"
                    },
                    "user": {
                        "title": "Current User",
                        "type": "object",
                        "properties": {
                            "id": {
                                "type": "string"
                            },
                            "name": {
                                "type": "string"
                            },
                            "email": {
                                "type": "string"
                            },
                            "email_verified_at": {
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "format": "date-time"
                            },
                            "avatar": {
                                "type": [
                                    "string",
                                    "null"
                                ]
                            },
                            "is_two_factor_enabled": {
                                "type": "boolean"
                            }
                        },
                        "required": [
                            "id",
                            "name",
                            "email",
                            "is_two_factor_enabled"
                        ],
                        "additionalProperties": false
                    }
                },
                "required": [
                    "token",
                    "user"
                ],
                "additionalProperties": false
            },
            "Auth.BridgeUrlData": {
                "title": "Bridge Url",
                "type": "object",
                "properties": {
                    "url": {
                        "type": "string"
                    }
                },
                "required": [
                    "url"
                ],
                "additionalProperties": false
            },
            "Auth.ChallengeTicketData": {
                "title": "Challenge Ticket",
                "type": "object",
                "properties": {
                    "ticket": {
                        "type": "string"
                    }
                },
                "required": [
                    "ticket"
                ],
                "additionalProperties": false
            },
            "Auth.ForgotPasswordData": {
                "title": "Forgot Password",
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string"
                    }
                },
                "required": [
                    "email"
                ],
                "additionalProperties": false
            },
            "Auth.LoginData": {
                "title": "Login",
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string"
                    },
                    "password": {
                        "type": "string"
                    },
                    "device_name": {
                        "default": null,
                        "type": [
                            "string",
                            "null"
                        ]
                    }
                },
                "required": [
                    "email",
                    "password"
                ],
                "additionalProperties": false
            },
            "Auth.RegisterUserData": {
                "title": "Register User",
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string"
                    },
                    "password": {
                        "type": "string"
                    },
                    "password_confirmation": {
                        "type": "string"
                    },
                    "device_name": {
                        "default": null,
                        "type": [
                            "string",
                            "null"
                        ]
                    }
                },
                "required": [
                    "name",
                    "email",
                    "password",
                    "password_confirmation"
                ],
                "additionalProperties": false
            },
            "Auth.ResetPasswordData": {
                "title": "Reset Password",
                "type": "object",
                "properties": {
                    "password": {
                        "type": "string"
                    },
                    "password_confirmation": {
                        "type": "string"
                    }
                },
                "required": [
                    "password",
                    "password_confirmation"
                ],
                "additionalProperties": false
            },
            "Auth.TwoFactorChallengeData": {
                "title": "Two Factor Challenge",
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string"
                    },
                    "ticket": {
                        "type": "string"
                    },
                    "code": {
                        "type": "string"
                    },
                    "device_name": {
                        "default": null,
                        "type": [
                            "string",
                            "null"
                        ]
                    }
                },
                "required": [
                    "email",
                    "ticket",
                    "code"
                ],
                "additionalProperties": false
            },
            "CurrentUserData": {
                "title": "Current User",
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string"
                    },
                    "email_verified_at": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date-time"
                    },
                    "avatar": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "is_two_factor_enabled": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "id",
                    "name",
                    "email",
                    "is_two_factor_enabled"
                ],
                "additionalProperties": false
            },
            "Entry.CreateData": {
                "title": "Create",
                "type": "object",
                "properties": {
                    "title": {
                        "type": "string",
                        "minLength": 3
                    },
                    "body": {
                        "type": "string",
                        "minLength": 10
                    },
                    "entry_date": {
                        "type": "string",
                        "x-date-format": "The value must match the format \"Y-m-d\"."
                    }
                },
                "required": [
                    "title",
                    "body",
                    "entry_date"
                ],
                "additionalProperties": false
            },
            "Entry.EntryData": {
                "title": "Entry",
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "title": {
                        "type": "string"
                    },
                    "body": {
                        "type": "string"
                    },
                    "entry_date": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time"
                    }
                },
                "required": [
                    "id",
                    "title",
                    "body",
                    "entry_date",
                    "created_at"
                ],
                "additionalProperties": false
            }
        }
    }
}
